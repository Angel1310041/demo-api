{
  "info": {
    "_postman_id": "16c67d92-30db-43f0-bfb0-73bd36c97250",
    "name": "API de autenticación y derechos ARCO",
    "description": "Registro, emisión de JWT en el login y derechos ARCO protegidos con Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://inventario.uttec" },
    { "key": "arcoUsername", "value": "" },
    { "key": "arcoPassword", "value": "" },
    { "key": "arcoEmail", "value": "" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "1. Registrar usuario",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{arcoUsername}}\",\n  \"password\": \"{{arcoPassword}}\",\n  \"nombreCompleto\": \"Usuario de prueba\",\n  \"email\": \"{{arcoEmail}}\",\n  \"telefono\": \"5551234\",\n  \"domicilio\": \"Calle de prueba 123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/registro"
          }
        },
        {
          "name": "2. Login y obtener Bearer token",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{arcoUsername}}\",\n  \"password\": \"{{arcoPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Derechos ARCO (autenticados)",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{accessToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "A. Acceso: consultar mi perfil",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/arco/perfil" }
        },
        {
          "name": "R. Rectificación: actualizar mis datos",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Usuario rectificado\",\n  \"email\": \"{{arcoEmail}}\",\n  \"telefono\": \"5559999\",\n  \"domicilio\": \"Nuevo domicilio 456\"\n}"
            },
            "url": "{{baseUrl}}/api/arco/perfil"
          }
        },
        {
          "name": "O. Oposición: oponerme al tratamiento",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"oposicionAlTratamiento\":true}" },
            "url": "{{baseUrl}}/api/arco/oposicion"
          }
        },
        {
          "name": "Verificar oposición registrada",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/arco/perfil" }
        },
        {
          "name": "C. Cancelación: eliminar mi cuenta (irreversible)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/arco/perfil" }
        }
      ]
    }
  ]
}